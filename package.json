{
  "name": "vscode-terminal-reader",
  "displayName": "Terminal Reader for Claude",
  "description": "Lets Claude Code read this VSCode window's terminals and Problems panel via a local MCP server. No more copy-pasting build output.",
  "version": "0.0.20",
  "publisher": "dwrigh",
  "license": "MIT",
  "icon": "resources/icon.png",
  "homepage": "https://github.com/davwright/vscode-terminal-reader#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/davwright/vscode-terminal-reader.git"
  },
  "bugs": {
    "url": "https://github.com/davwright/vscode-terminal-reader/issues"
  },
  "qna": "https://github.com/davwright/vscode-terminal-reader/issues",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "mcp",
    "ai",
    "terminal",
    "problems",
    "diagnostics",
    "agent",
    "anthropic"
  ],
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscodeTerminalReader.register",
        "title": "Terminal Reader: Register MCP server with Claude"
      },
      {
        "command": "vscodeTerminalReader.unregister",
        "title": "Terminal Reader: Unregister MCP server"
      },
      {
        "command": "vscodeTerminalReader.showStatus",
        "title": "Terminal Reader: Show status"
      },
      {
        "command": "vscodeTerminalReader.clearBuffers",
        "title": "Terminal Reader: Clear all buffers"
      },
      {
        "command": "vscodeTerminalReader.showHookStatus",
        "title": "Terminal Reader: Show active PreToolUse hooks"
      }
    ],
    "configuration": {
      "title": "Terminal Reader",
      "properties": {
        "vscodeTerminalReader.bufferLines": {
          "type": "number",
          "default": 10000,
          "description": "Maximum lines to retain per terminal/output buffer."
        },
        "vscodeTerminalReader.stripAnsi": {
          "type": "boolean",
          "default": true,
          "description": "Strip ANSI escape codes when reading buffers."
        }
      }
    }
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm run compile -- --watch",
    "lint": "tsc --noEmit",
    "icon": "node scripts/build-icon.js",
    "bump": "npm version patch --no-git-tag-version",
    "package": "npm run icon && npm run compile -- --minify",
    "vsix": "npx @vscode/vsce package --no-dependencies",
    "install-ext": "npm run bump && npm run package && npm run vsix && node scripts/install-vsix.js"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.93.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
